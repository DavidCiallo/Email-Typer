# 以下仅启动级配置：端口、管理员账号、SECRET、DATA_DIR 不支持在设置页修改。
SERVER_PORT=3300

# 加密密钥：修改会导致所有已存邮箱密码/会话无法解密，仅支持 .env。
SECRET=your-32-char-aes-secret-key-here!
NONCE_LENGTH=32

ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# --- 以下配置可在设置页修改（设置面板的对应项会覆盖这里的值） ---
# 留空保存设置项即清除覆盖、回退到这里的值。

ALLOWED_DOMAINS=example.com

RESEND_API_KEY=re_xxxxxxxx

MAILDIR_PATH=./eml
EMAIL_RECEIVE_API_KEY=

# Optional: data directory override (defaults to ./data)
# DATA_DIR=./data
# Optional: IMAP sync poll interval in seconds (default 60)
# MAILBOX_SYNC_INTERVAL=60
# Optional: max attachment size in bytes (default 10485760)
# ATTACHMENT_MAX_SIZE=10485760
# Optional: push API rate limit per key per minute (default 120, 0 = unlimited)
# PUSH_RATE_LIMIT_PER_MIN=120
