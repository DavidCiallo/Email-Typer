# DATA_DIR=./data
# Optional: IMAP sync poll interval in seconds (default 60)
# MAILBOX_SYNC_INTERVAL=60
# Optional: max attachment size in bytes (default 10485760)
# ATTACHMENT_MAX_SIZE=10485760
