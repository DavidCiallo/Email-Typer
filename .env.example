SERVER_PORT=3300

SECRET=your-32-char-aes-secret-key-here!
NONCE_LENGTH=32

ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

ALLOWED_DOMAINS=example.com

RESEND_API_KEY=re_xxxxxxxx

MAILDIR_PATH=./eml
EMAIL_RECEIVE_API_KEY=

